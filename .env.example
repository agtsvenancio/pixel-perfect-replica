# Copy these into your host's "Environment variables" (Hostinger: Node.js app → Settings).

# Build target for Hostinger (Node.js). Required on Hostinger.
NITRO_PRESET=node-server

# Password for the order admin at /admin. Required.
ADMIN_PASSWORD=choose-a-long-password

# MySQL database where orders are stored (Hostinger → Databases → MySQL).
# Use either DATABASE_URL or the separate DB_* variables.
DB_HOST=127.0.0.1  # use 127.0.0.1, not localhost (Hostinger + Node 17+)
DB_PORT=3306
DB_NAME=u123456789_orders
DB_USER=u123456789_admin
DB_PASSWORD=your-database-password
# DATABASE_URL=mysql://user:password@host:3306/database

# Without a database, orders are saved to DATA_DIR/orders.json (fine for local testing only).
# DATA_DIR=./data
